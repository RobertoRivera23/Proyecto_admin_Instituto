def generar_fechas_clase(fecha_inicio, fecha_fin, dias_curso):
    """
    Genera las fechas de clase basado en los días configurados
    """
    # Mapeo de días en español a números de dateutil
    dias_map = {
        'LUNES': rrule.MO,
        'MARTES': rrule.TU,
        'MIERCOLES': rrule.WE,
        'JUEVES': rrule.TH,
        'VIERNES': rrule.FR,
        'SABADO': rrule.SA,
        'DOMINGO': rrule.SU
    }
    
    dias_rrule = []
    if dias_curso:
        for dia in dias_curso.split(','):
            dia_limpio = dia.strip().upper()
            if dia_limpio in dias_map:
                dias_rrule.append(dias_map[dia_limpio])
    
    if not dias_rrule:
        return []
    
    # Convertir a objetos datetime si son date
    if isinstance(fecha_inicio, datetime):
        start_dt = fecha_inicio
    else:
        start_dt = datetime.combine(fecha_inicio, datetime.min.time())
    
    if isinstance(fecha_fin, datetime):
        end_dt = fecha_fin
    else:
        end_dt = datetime.combine(fecha_fin, datetime.min.time())
    
    fechas = list(rrule.rrule(
        rrule.WEEKLY,
        dtstart=start_dt,
        until=end_dt,
        byweekday=dias_rrule
    ))
    
    return [fecha.date() for fecha in fechas]

@login_required
def tomar_asistencia_unificada(request, curso_id):
    """
    Vista unificada para tomar asistencia - Acceso para:
    - Profesor del curso
    - Auxiliar asignado al curso  
    - Personal ADMINISTRATIVO
    - Personal COORDINADOR
    - Personal SECRETARIA
    - Superusuarios
    """
    print("=" * 60)
    print(f"🎯 VISTA tomar_asistencia_unificada - Usuario: {request.user.username}")
    
    # Obtener el curso
    curso = get_object_or_404(Curso, id=curso_id, activo=True, eliminado=False)
    print(f"🎯 Curso: {curso.nombre}")
    print(f"🎯 Profesor asignado: {curso.profesor}")
    print(f"🎯 Auxiliar asignado: {curso.auxiliar}")
    
    # Determinar roles del usuario
    es_profesor_del_curso = False
    es_auxiliar_del_curso = False
    es_personal_autorizado = False
    es_superusuario = request.user.is_superuser
    
    # Verificar si es profesor del curso
    try:
        profesor_usuario = Profesor.objects.get(user=request.user, activo=True, eliminado=False)
        print(f"🎯 Profesor encontrado en DB: {profesor_usuario}")
        
        if curso.profesor == profesor_usuario:
            es_profesor_del_curso = True
            print("✅ ES EL PROFESOR ASIGNADO AL CURSO")
    except Profesor.DoesNotExist:
        print("⚠️ Usuario no tiene perfil de profesor")
    
    # ==============================================
    # VERIFICACIÓN MEJORADA DEL AUXILIAR
    # ==============================================
    try:
        if curso.auxiliar:
            print(f"🎯 Auxiliar asignado en curso: {curso.auxiliar}")
            print(f"🎯 ID auxiliar: {curso.auxiliar.id}")
            print(f"🎯 Usuario del auxiliar: {curso.auxiliar.user}")
            print(f"🎯 Es usuario None?: {curso.auxiliar.user is None}")
            print(f"🎯 Usuario actual: {request.user}")
            print(f"🎯 ID Usuario actual: {request.user.id}")
            
            # Verificar primero si el auxiliar tiene un usuario asignado
            if curso.auxiliar.user:
                if curso.auxiliar.user.id == request.user.id:
                    es_auxiliar_del_curso = True
                    print("✅ ES EL AUXILIAR ASIGNADO AL CURSO (verificado por usuario)")
                else:
                    print(f"❌ Usuarios no coinciden: {curso.auxiliar.user.id} != {request.user.id}")
            else:
                print("⚠️ El auxiliar asignado no tiene usuario del sistema")
                # Intentar crear usuario automáticamente si no existe
                try:
                    user_creado = curso.auxiliar.crear_usuario_sistema()
                    if user_creado:
                        print(f"✅ Usuario creado automáticamente: {user_creado}")
                        # Refrescar el objeto desde la base de datos
                        curso.auxiliar.refresh_from_db()
                        
                        # Ahora verificar si coincide con el usuario actual
                        if curso.auxiliar.user and curso.auxiliar.user.id == request.user.id:
                            es_auxiliar_del_curso = True
                            print("✅ ES EL AUXILIAR ASIGNADO AL CURSO (usuario creado automáticamente)")
                        else:
                            print("⚠️ Usuario creado no coincide con usuario actual")
                    else:
                        print("❌ No se pudo crear usuario para el auxiliar")
                except Exception as e:
                    print(f"❌ Error al crear usuario para auxiliar: {e}")
    except Exception as e:
        print(f"❌ Error al verificar auxiliar: {e}")
    
    # Verificar si es personal autorizado (ADMINISTRATIVO, COORDINADOR, SECRETARIA)
    try:
        personal = Personal.objects.get(user=request.user, activo=True, eliminado=False)
        print(f"🎯 Personal encontrado en DB: {personal}, Tipo: {personal.tipo}")
        
        # Verificar si este personal es el auxiliar del curso
        if curso.auxiliar and curso.auxiliar.id == personal.id:
            es_auxiliar_del_curso = True
            print("✅ ES EL AUXILIAR ASIGNADO AL CURSO (verificado por ID de Personal)")
        
        # Verificar si es personal autorizado para tomar asistencia
        if personal.tipo in ['ADMINISTRATIVO', 'COORDINADOR', 'SECRETARIA']:
            es_personal_autorizado = True
            print(f"✅ Es {personal.tipo} - AUTORIZADO para tomar asistencia")
            
    except Personal.DoesNotExist:
        print("⚠️ Usuario no tiene perfil de personal")
    
    # ==============================================
    # VERIFICACIÓN ADICIONAL POR EMAIL/LEGAJO
    # ==============================================
    if not es_auxiliar_del_curso and curso.auxiliar:
        print("🎯 Verificación adicional de auxiliar:")
        print(f"   Email auxiliar: {curso.auxiliar.mail}")
        print(f"   Email usuario: {request.user.email}")
        print(f"   Legajo auxiliar: {curso.auxiliar.legajo}")
        
        # Verificar por email
        if curso.auxiliar.mail and curso.auxiliar.mail == request.user.email:
            es_auxiliar_del_curso = True
            print("✅ ES EL AUXILIAR (verificado por email)")
        
        # Verificar por legajo (si el username es el legajo)
        if curso.auxiliar.legajo and curso.auxiliar.legajo == request.user.username:
            es_auxiliar_del_curso = True
            print("✅ ES EL AUXILIAR (verificado por legajo/username)")
    
    # ==============================================
    # VERIFICACIÓN DE PERMISOS - SOBREESCRIBE CUALQUIER DECORADOR
    # ==============================================
    
    # Lista de todos los roles autorizados para ACCEDER a la página
    roles_autorizados_acceso = [
        es_profesor_del_curso,
        es_auxiliar_del_curso, 
        es_personal_autorizado,
        es_superusuario
    ]
    
    # Si NINGUNO de los roles es verdadero, el usuario NO tiene permiso
    if not any(roles_autorizados_acceso):
        print("❌ USUARIO NO AUTORIZADO:")
        print(f"   - Es profesor del curso: {es_profesor_del_curso}")
        print(f"   - Es auxiliar del curso: {es_auxiliar_del_curso}")
        print(f"   - Es personal autorizado: {es_personal_autorizado}")
        print(f"   - Es superusuario: {es_superusuario}")
        
        messages.error(
            request, 
            "No tienes permiso para acceder a esta página. "
            "Solo pueden acceder: profesor del curso, auxiliar asignado, "
            "personal administrativo, coordinadores, secretarías o superusuarios."
        )
        
        # Redirigir según el tipo de usuario
        try:
            Profesor.objects.get(user=request.user, activo=True, eliminado=False)
            return redirect('mis_cursos_profesor')
        except Profesor.DoesNotExist:
            pass
        
        try:
            Personal.objects.get(user=request.user, activo=True, eliminado=False)
            return redirect('dashboard_personal')
        except Personal.DoesNotExist:
            pass
        
        return redirect('dashboard')
    
    # ==============================================
    # DETERMINAR SI PUEDE EDITAR
    # ==============================================
    
    # Reglas para editar:
    # 1. Profesor del curso: SIEMPRE puede editar
    # 2. Auxiliar del curso: SIEMPRE puede editar  
    # 3. Personal autorizado: depende del parámetro ?editar=1
    # 4. Superusuarios: SIEMPRE pueden editar
    
    puede_editar = False
    
    if es_profesor_del_curso:
        puede_editar = True
        print("✅ Puede editar (es profesor del curso)")
    elif es_auxiliar_del_curso:
        puede_editar = True
        print("✅ Puede editar (es auxiliar del curso)")
    elif es_superusuario:
        puede_editar = True
        print("✅ Puede editar (es superusuario)")
    elif es_personal_autorizado:
        # Para personal administrativo/coordinador/secretaría, usar parámetro editar
        puede_editar = request.GET.get('editar') == '1'
        print(f"✅ Personal autorizado - Puede editar: {puede_editar}")
    else:
        print("❌ No puede editar (no tiene permisos)")
    
    hoy = timezone.now().date()
    
    # Obtener inscripciones
    inscripciones = Inscripcion.objects.filter(
        curso=curso,
        activo=True,
        estado__in=['INSCRIPTO', 'CURSANDO']
    ).select_related('alumno')
    
    print(f"📊 Total alumnos inscritos: {inscripciones.count()}")
    
    # Manejar POST (guardar asistencia)
    if request.method == 'POST' and puede_editar:
        try:
            fecha_str = request.POST.get('fecha', hoy.isoformat())
            fecha = datetime.strptime(fecha_str, '%Y-%m-%d').date()
            
            # Verificar que la fecha no sea futura
            if fecha > hoy:
                messages.error(request, 'No puedes tomar asistencia para fechas futuras')
                return redirect('tomar_asistencia_profesor', curso_id=curso.id)
            
            # Lista para almacenar alumnos con ausencias consecutivas
            alumnos_con_ausencias_consecutivas = []
            
            # Procesar cada alumno
            for inscripcion in inscripciones:
                alumno_id = str(inscripcion.alumno.id)
                presente = request.POST.get(f'presente_{alumno_id}') == 'on'
                observaciones = request.POST.get(f'observaciones_{alumno_id}', '').strip()
                
                # Crear o actualizar asistencia
                Asistencia.objects.update_or_create(
                    inscripcion=inscripcion,
                    fecha=fecha,
                    defaults={
                        'presente': presente,
                        'observaciones': observaciones,
                        'registrado_por': request.user,
                    }
                )
                
                # ==============================================
                # VERIFICAR AUSENCIAS CONSECUTIVAS
                # ==============================================
                if not presente:  # Si el alumno está ausente hoy
                    # 1. Obtener todas las fechas de clase hasta hoy
                    fechas_clase = generar_fechas_clase(
                        curso.fecha_inicio,
                        fecha,
                        curso.dias
                    )
                    
                    if len(fechas_clase) >= 2:
                        # 2. Encontrar la posición de la fecha actual en la lista
                        try:
                            indice_actual = fechas_clase.index(fecha)
                        except ValueError:
                            # La fecha actual no es día de clase
                            continue
                        
                        # 3. Si no es la primera clase, verificar la anterior
                        if indice_actual > 0:
                            fecha_clase_anterior = fechas_clase[indice_actual - 1]
                            
                            # 4. Buscar asistencia de la clase anterior
                            try:
                                asistencia_anterior = Asistencia.objects.get(
                                    inscripcion=inscripcion,
                                    fecha=fecha_clase_anterior
                                )
                                
                                # 5. Si también estuvo ausente en la clase anterior
                                if not asistencia_anterior.presente:
                                    alumnos_con_ausencias_consecutivas.append({
                                        'alumno': inscripcion.alumno,
                                        'fecha_actual': fecha,
                                        'fecha_anterior': fecha_clase_anterior
                                    })
                                    print(f"⚠️ ALERTA: {inscripcion.alumno.nombre_completo()} falta 2 veces consecutivas")
                                    
                            except Asistencia.DoesNotExist:
                                # No hay registro de la clase anterior
                                pass
            
            messages.success(request, f'Asistencia del {fecha.strftime("%d/%m/%Y")} guardada correctamente')
            
            # ==============================================
            # NOTIFICACIONES POR AUSENCIAS CONSECUTIVAS
            # ==============================================
            if alumnos_con_ausencias_consecutivas and curso.auxiliar and curso.auxiliar.user:
                try:
                    # Buscar o crear tipo de notificación
                    tipo_ausencia_consecutiva, created = TipoNotificacion.objects.get_or_create(
                        codigo='AUSENCIA_CONSECUTIVA',
                        defaults={
                            'nombre': 'Ausencia Consecutiva de Alumno',
                            'descripcion': 'Notificaciones por ausencias consecutivas de alumnos',
                            'prioridad': 'ALTA',
                            'color': 'warning',
                            'icono': 'fa-user-times',
                            'ES_MANUAL': False,
                        }
                    )
                    
                    if created:
                        coordinadores = Personal.objects.filter(
                            tipo__in=['COORDINADOR', 'ADMINISTRATIVO', 'SECRETARIA'],
                            activo=True,
                            eliminado=False
                        )
                        tipo_ausencia_consecutiva.PUEDE_ASIGNAR.set(coordinadores)
                        tipo_ausencia_consecutiva.save()
                        print(f"✅ Tipo de notificación creado: {tipo_ausencia_consecutiva}")
                    
                    # Crear notificaciones
                    notificaciones_creadas = 0
                    
                    for registro in alumnos_con_ausencias_consecutivas:
                        alumno = registro['alumno']
                        fecha_actual = registro['fecha_actual']
                        fecha_anterior = registro['fecha_anterior']
                        
                        # Verificar si ya existe notificación reciente
                        notificacion_existente = Notificacion.objects.filter(
                            usuario_destino=curso.auxiliar.user,
                            tipo=tipo_ausencia_consecutiva,
                            titulo__icontains=f"Ausencia consecutiva - {alumno.nombre_completo()}",
                            fecha_creacion__gte=timezone.now() - timedelta(days=7)
                        ).exists()
                        
                        if not notificacion_existente:
                            Notificacion.objects.create(
                                usuario_destino=curso.auxiliar.user,
                                usuario_origen=None,
                                tipo=tipo_ausencia_consecutiva,
                                titulo=f'Ausencia consecutiva - {alumno.nombre_completo()}',
                                mensaje=(
                                    f'El alumno {alumno.nombre_completo()} ha faltado a 2 clases consecutivas del curso "{curso.nombre}".\n'
                                    f'• Última ausencia: {fecha_actual.strftime("%d/%m/%Y")}\n'
                                    f'• Ausencia anterior: {fecha_anterior.strftime("%d/%m/%Y")}\n'
                                    f'• DNI: {alumno.dni}\n'
                                    f'• Teléfono: {alumno.telefono or "No disponible"}\n'
                                    f'• Email: {alumno.email or "No disponible"}'
                                ),
                                estado='PENDIENTE',
                                prioridad='ALTA',
                                es_manual=False
                            )
                            notificaciones_creadas += 1
                            print(f"✅ Notificación creada para auxiliar por ausencia consecutiva de {alumno.nombre_completo()}")
                    
                    if notificaciones_creadas > 0:
                        print(f"✅ {notificaciones_creadas} notificaciones de ausencia consecutiva creadas")
                        
                        # Informar al usuario
                        messages.info(request, 
                            f'Se ha notificado al auxiliar administrativo sobre {notificaciones_creadas} '
                            f'alumno(s) con ausencias consecutivas.'
                        )
                            
                except Exception as e:
                    print(f"⚠️ Error al crear notificaciones por ausencia consecutiva: {e}")
            
            return redirect('tomar_asistencia_profesor', curso_id=curso.id)
            
        except Exception as e:
            print(f"❌ Error al guardar asistencia: {e}")
            messages.error(request, f'Error al guardar asistencia: {str(e)}')
    
    # Para GET: mostrar formulario
    fecha_str = request.GET.get('fecha', hoy.isoformat())
    try:
        fecha = datetime.strptime(fecha_str, '%Y-%m-%d').date()
    except:
        fecha = hoy
    
    print(f"📅 Fecha seleccionada: {fecha}")
    
    # Obtener asistencias para la fecha seleccionada
    asistencias_fecha = Asistencia.objects.filter(
        inscripcion__curso=curso,
        fecha=fecha
    ).select_related('inscripcion', 'inscripcion__alumno', 'registrado_por')
    
    print(f"📝 Asistencias encontradas para {fecha}: {asistencias_fecha.count()}")
    
    # Crear diccionario para fácil acceso
    asistencias_dict = {}
    for asistencia in asistencias_fecha:
        asistencias_dict[asistencia.inscripcion.alumno.id] = asistencia
    
    # Calcular porcentaje de asistencia del curso
    try:
        total_asistencias = Asistencia.objects.filter(inscripcion__curso=curso).count()
        total_presentes = Asistencia.objects.filter(inscripcion__curso=curso, presente=True).count()
        porcentaje_asistencia = (total_presentes / total_asistencias * 100) if total_asistencias > 0 else 0
    except:
        porcentaje_asistencia = 0
    
    context = {
        'curso': curso,
        'inscripciones': inscripciones,
        'es_profesor_del_curso': es_profesor_del_curso,
        'es_auxiliar_del_curso': es_auxiliar_del_curso,
        'es_personal_autorizado': es_personal_autorizado,
        'es_superusuario': es_superusuario,
        'puede_editar': puede_editar,
        'hoy': hoy,
        'fecha_seleccionada': fecha,
        'asistencias_dict': asistencias_dict,
        'porcentaje_asistencia': round(porcentaje_asistencia, 2),
        'total_alumnos': inscripciones.count(),
        'puede_ver_reportes': True,  # Todos los autorizados pueden ver reportes
    }
    
    print("=" * 60)
    return render(request, 'web/profesores/tomar_asistencia.html', context)

# ============================================
# NOTAS Y EXÁMENES
# ============================================

@login_required
@requiere_permiso_profesor
def gestionar_notas(request, curso_id):
    curso = get_object_or_404(Curso, id=curso_id, activo=True)
    
    if not (getattr(request, 'es_administrador', False) or curso.profesor_id == request.profesor.id):
        messages.error(request, "No tienes permiso para gestionar este curso.")
        return redirect('dashboard_profesor')
    
    inscripciones = Inscripcion.objects.filter(
        curso=curso,
        activo=True,
        estado__in=['INSCRIPTO', 'CURSANDO']
    ).select_related('alumno')
    
    # Tipos de examen disponibles
    tipos_examen = Examen.TIPO_CHOICES  # lista de tuplas
    
    # Obtener exámenes existentes
    examenes = Examen.objects.filter(inscripcion__curso=curso).select_related('inscripcion')
    examenes_dict = {}
    for examen in examenes:
        insc_id = examen.inscripcion.id
        if insc_id not in examenes_dict:
            examenes_dict[insc_id] = {}
        examenes_dict[insc_id][examen.tipo] = examen
    
    if request.method == 'POST':
        # Verificar si es una eliminación
        if 'eliminar_examen' in request.POST:
            examen_id = request.POST.get('eliminar_examen')
            try:
                examen = Examen.objects.get(id=examen_id, inscripcion__curso=curso)
                examen.delete()
                messages.success(request, "Examen eliminado correctamente.")
            except Examen.DoesNotExist:
                messages.error(request, "El examen no existe.")
            return redirect('gestionar_notas', curso_id=curso.id)
        
        # Procesar guardado de notas
        try:
            for inscripcion in inscripciones:
                for tipo, _ in tipos_examen:
                    nota_key = f"nota_{inscripcion.id}_{tipo}"
                    incluir_key = f"incluir_{inscripcion.id}_{tipo}"
                    
                    if nota_key in request.POST and request.POST[nota_key].strip():
                        # Hay nota, procesar
                        try:
                            nota = float(request.POST[nota_key])
                            incluir = incluir_key in request.POST  # True si el checkbox está marcado
                            Examen.objects.update_or_create(
                                inscripcion=inscripcion,
                                tipo=tipo,
                                defaults={
                                    'nota': nota,
                                    'incluir_en_promedio': incluir,
                                    'fecha': timezone.now().date(),
                                    # observaciones? Podríamos agregar un campo de observaciones si se necesita
                                }
                            )
                        except ValueError:
                            continue
                    # Si no hay nota, no hacemos nada (no eliminamos exámenes existentes)
            messages.success(request, 'Notas guardadas correctamente.')
        except Exception as e:
            messages.error(request, f'Error al guardar notas: {str(e)}')
        
        return redirect('gestionar_notas', curso_id=curso.id)
    
    context = {
        'curso': curso,
        'inscripciones': inscripciones,
        'tipos_examen': tipos_examen,
        'examenes_dict': examenes_dict,
    }
    return render(request, 'web/profesores/gestionar_notas.html', context)

# ============================================
# VISTAS ESPECIALES PARA ADMINISTRADORES
# ============================================

@login_required
def switch_modo_profesor(request):
    """
    Cambia entre modo 'admin' y modo 'profesor'
    Solo para administradores/coordinadores que también son profesores
    """
    modo = request.GET.get('modo', 'profesor')
    
    # Verificar que es administrador
    if not getattr(request, 'es_administrador', False):
        messages.error(request, "Solo administradores pueden cambiar de modo")
        return redirect('dashboard_profesor')
    
    # Verificar que tiene perfil de profesor
    profesor = getattr(request, 'profesor', None)
    if not profesor and modo == 'profesor':
        messages.error(request, "No tienes perfil de profesor para activar este modo")
        return redirect('dashboard_admin_general')  # Redirigir al dashboard admin
    
    # Cambiar modo
    request.session['modo_profesor'] = modo
    
    if modo == 'profesor':
        messages.success(request, f"Modo profesor activado. Viendo como: {profesor.nombre_completo()}")
        return redirect('dashboard_profesor')
    else:
        messages.success(request, "Modo administrador activado")
        return redirect('dashboard_admin_general')  # Redirigir al dashboard admin
    
# ============================================
# AJAX/RÁPIDAS
# ============================================

@login_required
@requiere_permiso_profesor
@require_GET
def obtener_estadisticas_curso(request, curso_id):
    """Obtener estadísticas del curso (AJAX)"""
    try:
        from django.db.models import Avg, Count
        
        es_admin = request.es_administrador
        profesor = request.profesor
        
        # Obtener curso con permisos
        from .models import Curso
        if es_admin:
            curso = Curso.objects.get(id=curso_id, activo=True, eliminado=False)
        else:
            curso = Curso.objects.get(id=curso_id, profesor=profesor, activo=True, eliminado=False)
        
        # Estadísticas
        inscripciones = Inscripcion.objects.filter(
            curso=curso,
            activo=True,
            estado__in=['INSCRIPTO', 'CURSANDO']
        )
        
        total_alumnos = inscripciones.count()
        
        # Asistencia del mes
        hoy = timezone.now().date()
        asistencias_mes = Asistencia.objects.filter(
            inscripcion__curso=curso,
            fecha__month=hoy.month,
            fecha__year=hoy.year
        )
        total_asistencias = asistencias_mes.count()
        presentes = asistencias_mes.filter(presente=True).count()
        porcentaje_asistencia = (presentes / total_asistencias * 100) if total_asistencias > 0 else 0
        
        # Notas
        examenes = Examen.objects.filter(inscripcion__curso=curso)
        promedio_notas = examenes.aggregate(prom=Avg('nota'))['prom'] if examenes.exists() else None
        
        # Alumnos con bajo rendimiento (< 6)
        alumnos_bajo_rendimiento = 0
        for inscripcion in inscripciones:
            examenes_alumno = Examen.objects.filter(inscripcion=inscripcion)
            if examenes_alumno.exists():
                promedio = examenes_alumno.aggregate(prom=Avg('nota'))['prom']
                if promedio and promedio < 6:
                    alumnos_bajo_rendimiento += 1
        
        return JsonResponse({
            'success': True,
            'data': {
                'total_alumnos': total_alumnos,
                'porcentaje_asistencia': round(porcentaje_asistencia, 1),
                'promedio_notas': round(promedio_notas, 2) if promedio_notas else None,
                'alumnos_bajo_rendimiento': alumnos_bajo_rendimiento,
                'presentes_mes': presentes,
                'total_clases_mes': total_asistencias // total_alumnos if total_alumnos > 0 else 0,
            }
        })
        
    except Exception as e:
        return JsonResponse({'success': False, 'error': str(e)})
    
    
# ============================================
# VISTAS PARA EXÁMENES INDIVIDUALES
# ============================================

@login_required
@requiere_permiso_profesor
def agregar_examen_individual(request, inscripcion_id):
    """
    Vista para agregar un examen individual a un alumno inscrito en un curso.
    Accesible para profesores y administradores.
    """
    # Obtener la inscripción
    inscripcion = get_object_or_404(Inscripcion, id=inscripcion_id, activo=True)
    alumno = inscripcion.alumno
    curso = inscripcion.curso
    
    # Verificar permisos específicos
    es_admin = request.es_administrador
    profesor = request.profesor
    
    if not es_admin and curso.profesor != profesor:
        messages.error(request, "Solo el profesor asignado puede agregar exámenes en este curso")
        return redirect('detalle_curso_profesor', curso_id=curso.id)
    
    # Obtener exámenes existentes para este alumno en el curso
    examenes_existentes = Examen.objects.filter(inscripcion=inscripcion)
    tipos_existentes = [examen.tipo for examen in examenes_existentes]
    
    # Filtrar tipos disponibles (excluir los ya existentes)
    TIPO_CHOICES_FILTRADOS = [
        choice for choice in Examen.TIPO_CHOICES 
        if choice[0] not in tipos_existentes
    ]
    
    if request.method == 'POST':
        # Crear formulario con datos POST
        form = ExamenForm(request.POST, TIPO_CHOICES=TIPO_CHOICES_FILTRADOS)
        
        if form.is_valid():
            try:
                examen = form.save(commit=False)
                examen.inscripcion = inscripcion
                
                # Verificar que no exista ya un examen del mismo tipo
                if Examen.objects.filter(inscripcion=inscripcion, tipo=examen.tipo).exists():
                    messages.error(request, f"Ya existe un examen de tipo {examen.get_tipo_display()} para este alumno")
                else:
                    examen.save()
                    
                    # Registrar en historial
                    HistorialCambios.objects.create(
                        usuario=request.user,
                        modelo_afectado='EXAMEN',
                        objeto_id=examen.id,
                        accion='CREACION',
                        detalles=f"Examen agregado: {examen.get_tipo_display()} - Nota: {examen.nota}",
                        ip_address=request.META.get('REMOTE_ADDR')
                    )
                    
                    messages.success(request, f"Examen {examen.get_tipo_display()} agregado exitosamente")
                    
                    # Redirigir según parámetro
                    redireccion = request.GET.get('redirect_to', 'detalle_alumno_curso')
                    if redireccion == 'detalle_curso':
                        return redirect('detalle_curso_profesor', curso_id=curso.id)
                    else:
                        return redirect('detalle_alumno_curso', curso_id=curso.id, alumno_id=alumno.id)
                        
            except Exception as e:
                messages.error(request, f"Error al guardar el examen: {str(e)}")
        else:
            messages.error(request, "Por favor, corrige los errores en el formulario")
    else:
        # Formulario inicial con fecha actual
        form = ExamenForm(TIPO_CHOICES=TIPO_CHOICES_FILTRADOS, initial={
            'fecha': timezone.now().date()
        })
    
    # Calcular estadísticas del alumno
    promedio_examenes = examenes_existentes.aggregate(Avg('nota'))['nota__avg']
    mejor_examen = examenes_existentes.order_by('-nota').first()
    peor_examen = examenes_existentes.order_by('nota').first()
    
    context = {
        'titulo': f'Agregar Examen - {alumno.nombre_completo()}',
        'form': form,
        'alumno': alumno,
        'curso': curso,
        'inscripcion': inscripcion,
        'es_administrador': es_admin,
        'examenes_existentes': examenes_existentes,
        'tipos_disponibles': TIPO_CHOICES_FILTRADOS,
        'promedio_actual': round(promedio_examenes, 2) if promedio_examenes else None,
        'mejor_examen': mejor_examen,
        'peor_examen': peor_examen,
        'tipo_acceso': request.tipo_acceso,
    }
    
    return render(request, 'web/profesores/agregar_examen.html', context)


@login_required
@requiere_permiso_profesor
def editar_examen(request, examen_id):
    """
    Vista para editar un examen existente
    """
    examen = get_object_or_404(Examen, id=examen_id)
    inscripcion = examen.inscripcion
    alumno = inscripcion.alumno
    curso = inscripcion.curso
    
    # Verificar permisos
    es_admin = request.es_administrador
    profesor = request.profesor
    
    if not es_admin and curso.profesor != profesor:
        messages.error(request, "No tienes permiso para editar este examen")
        return redirect('detalle_curso_profesor', curso_id=curso.id)
    
    if request.method == 'POST':
        form = ExamenForm(request.POST, instance=examen)
        if form.is_valid():
            examen_original = Examen.objects.get(id=examen_id)
            nota_original = examen_original.nota
            tipo_original = examen_original.get_tipo_display()
            
            examen_editado = form.save()
            
            # Registrar en historial
            HistorialCambios.objects.create(
                usuario=request.user,
                modelo_afectado='EXAMEN',
                objeto_id=examen.id,
                accion='MODIFICACION',
                detalles=f"Examen modificado: {tipo_original} - Nota: {nota_original} → {examen_editado.nota}",
                ip_address=request.META.get('REMOTE_ADDR')
            )
            
            messages.success(request, "Examen actualizado correctamente")
            
            redireccion = request.GET.get('redirect_to', 'detalle_alumno_curso')
            if redireccion == 'detalle_curso':
                return redirect('detalle_curso_profesor', curso_id=curso.id)
            else:
                return redirect('detalle_alumno_curso', curso_id=curso.id, alumno_id=alumno.id)
    else:
        form = ExamenForm(instance=examen)
    
    context = {
        'titulo': f'Editar Examen - {alumno.nombre_completo()}',
        'form': form,
        'examen': examen,
        'alumno': alumno,
        'curso': curso,
        'es_administrador': es_admin,
        'tipo_acceso': request.tipo_acceso,
    }
    
    return render(request, 'web/profesores/editar_examen.html', context)


@login_required
@requiere_permiso_profesor
@require_POST
def eliminar_examen(request, examen_id):
    """
    Eliminar un examen (solo administradores)
    """
    examen = get_object_or_404(Examen, id=examen_id)
    inscripcion = examen.inscripcion
    curso = inscripcion.curso
    
    # Solo administradores pueden eliminar
    if not request.es_administrador:
        return JsonResponse({
            'success': False,
            'error': 'Solo administradores pueden eliminar exámenes'
        })
    
    try:
        # Registrar antes de eliminar
        HistorialCambios.objects.create(
            usuario=request.user,
            modelo_afectado='EXAMEN',
            objeto_id=examen.id,
            accion='ELIMINACION',
            detalles=f"Examen eliminado: {examen.get_tipo_display()} - Nota: {examen.nota}",
            ip_address=request.META.get('REMOTE_ADDR')
        )
        
        examen.delete()
        
        return JsonResponse({
            'success': True,
            'message': 'Examen eliminado correctamente'
        })
    except Exception as e:
        return JsonResponse({
            'success': False,
            'error': str(e)
        })
        
