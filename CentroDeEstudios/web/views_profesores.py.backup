# CURSOS (DIFERENCIADO POR ROL)
# ============================================

@login_required
@requiere_permiso_profesor
def mis_cursos(request):
    """Lista de cursos - Diferente para profesores y administradores"""
    
    # OBTENER PROFESOR DE FORMA SEGURA
    profesor = None
    
    # 1. Intentar obtener de request.profesor
    if hasattr(request, 'profesor'):
        profesor = request.profesor
        print(f"✅ Profesor obtenido de request.profesor: {profesor}")
    
    # 2. Si no, intentar obtener de request.profesor_obj
    elif hasattr(request, 'profesor_obj'):
        profesor = request.profesor_obj
        print(f"✅ Profesor obtenido de request.profesor_obj: {profesor}")
    
    # 3. Si no, intentar obtener por usuario
    else:
        try:
            profesor = Profesor.objects.get(user=request.user)
            print(f"✅ Profesor obtenido de base de datos: {profesor}")
        except Profesor.DoesNotExist:
            profesor = None
            print(f"⚠️ No se encontró profesor para el usuario: {request.user.username}")
    
    # DETERMINAR SI ES ADMINISTRADOR
    es_admin = False
    if hasattr(request, 'es_administrador'):
        es_admin = request.es_administrador
    else:
        # Calcular manualmente
        es_admin = request.user.is_superuser or request.user.groups.filter(
            name__in=['Administrativo', 'Coordinador']
        ).exists()
    
    print(f"🔍 Es administrador: {es_admin}")
    
    # OBTENER FECHA ACTUAL
    hoy = timezone.now().date()
    
    # Filtros comunes
    estado = request.GET.get('estado', 'activos')
    busqueda = request.GET.get('buscar', '')
    
    # Determinar qué cursos mostrar
    if es_admin:
        # Administradores ven TODOS los cursos
        if estado == 'activos':
            cursos = Curso.objects.filter(
                activo=True, 
                eliminado=False,
                fecha_fin__gte=hoy  # Filtro para cursos activos (no finalizados)
            )
        elif estado == 'finalizados':
            cursos = Curso.objects.filter(
                fecha_fin__lt=hoy, 
                activo=True, 
                eliminado=False
            )
        elif estado == 'inactivos':
            cursos = Curso.objects.filter(
                activo=False, 
                eliminado=False
            )
        else:  # todos (incluye inactivos pero no eliminados)
            cursos = Curso.objects.filter(eliminado=False)
        
        titulo = "Todos los Cursos"
        mostrar_profesor = True
    else:
        # Profesores ven solo SUS cursos
        if not profesor:
            # Si no es profesor ni admin, redirigir
            from django.contrib import messages
            messages.error(request, "No tienes permisos para acceder a esta sección.")
            return redirect('home')
        
        if estado == 'activos':
            cursos = profesor.cursos_asignados.filter(
                activo=True, 
                eliminado=False,
                fecha_fin__gte=hoy  # Filtro para cursos activos (no finalizados)
            )
        elif estado == 'finalizados':
            cursos = profesor.cursos_asignados.filter(
                fecha_fin__lt=hoy, 
                activo=True, 
                eliminado=False
            )
        elif estado == 'inactivos':
            cursos = profesor.cursos_asignados.filter(
                activo=False, 
                eliminado=False
            )
        else:  # todos (sus cursos no eliminados)
            cursos = profesor.cursos_asignados.filter(eliminado=False)
        
        titulo = "Mis Cursos"
        mostrar_profesor = False
    
    # Búsqueda
    if busqueda:
        if es_admin:
            cursos = cursos.filter(
                Q(nombre__icontains=busqueda) |
                Q(dias__icontains=busqueda) |
                Q(horario__icontains=busqueda) |
                Q(profesor__nombre__icontains=busqueda) |
                Q(profesor__apellido__icontains=busqueda)
            )
        else:
            cursos = cursos.filter(
                Q(nombre__icontains=busqueda) |
                Q(dias__icontains=busqueda) |
                Q(horario__icontains=busqueda)
            )
    
    # Ordenar
    cursos = cursos.order_by('-fecha_inicio')
    
    # CALCULAR ESTADÍSTICAS PARA EL TEMPLATE
    if es_admin:
        # Estadísticas para administrador
        total_cursos = Curso.objects.filter(eliminado=False).count()
        cursos_activos_total = Curso.objects.filter(
            activo=True, 
            eliminado=False,
            fecha_fin__gte=hoy
        ).count()
        cursos_finalizados_total = Curso.objects.filter(
            fecha_fin__lt=hoy,
            activo=True,
            eliminado=False
        ).count()
        cursos_inactivos_total = Curso.objects.filter(
            activo=False,
            eliminado=False
        ).count()
        
        # Para el template, también necesitamos los QuerySets filtrados para mostrar en las tarjetas
        cursos_activos_queryset = Curso.objects.filter(
            activo=True, 
            eliminado=False,
            fecha_fin__gte=hoy
        )
        cursos_finalizados_queryset = Curso.objects.filter(
            fecha_fin__lt=hoy,
            activo=True,
            eliminado=False
        )
    else:
        # Estadísticas para profesor
        total_cursos = profesor.cursos_asignados.filter(eliminado=False).count()
        cursos_activos_total = profesor.cursos_asignados.filter(
            activo=True, 
            eliminado=False,
            fecha_fin__gte=hoy
        ).count()
        cursos_finalizados_total = profesor.cursos_asignados.filter(
            fecha_fin__lt=hoy,
            activo=True,
            eliminado=False
        ).count()
        cursos_inactivos_total = profesor.cursos_asignados.filter(
            activo=False,
            eliminado=False
        ).count()
        
        # QuerySets filtrados para el profesor
        cursos_activos_queryset = profesor.cursos_asignados.filter(
            activo=True, 
            eliminado=False,
            fecha_fin__gte=hoy
        )
        cursos_finalizados_queryset = profesor.cursos_asignados.filter(
            fecha_fin__lt=hoy,
            activo=True,
            eliminado=False
        )
    
    # Paginación
    page = request.GET.get('page', 1)
    paginator = Paginator(cursos, 10)
    
    try:
        cursos_paginados = paginator.page(page)
    except:
        cursos_paginados = paginator.page(1)
    
    context = {
        'titulo': titulo,
        'cursos': cursos_paginados,
        'es_administrador': es_admin,
        'mostrar_profesor': mostrar_profesor,
        'cursos_activos': cursos_activos_total,  # Conteo para estadísticas
        'cursos_finalizados': cursos_finalizados_total,  # Conteo para estadísticas
        'cursos_inactivos': cursos_inactivos_total,  # Conteo para estadísticas
        'total_cursos': total_cursos,
        'estado_filtro': estado,
        'busqueda_actual': busqueda,
        'tipo_acceso': getattr(request, 'tipo_acceso', 'profesor'),
        
        # NUEVAS VARIABLES PARA EL TEMPLATE (QuerySets)
        'cursos_activos_queryset': cursos_activos_queryset,  # Para usar en el template con .count
        'cursos_finalizados_queryset': cursos_finalizados_queryset,  # Para usar en el template
        'hoy': hoy,  # Pasar la fecha actual al template
    }
    
    return render(request, 'web/profesores/mis_cursos.html', context)

@login_required
@requiere_permiso_profesor
def detalle_curso_profesor(request, curso_id):
    """Vista de solo lectura - Muestra detalles del curso"""
    # Lógica de solo lectura
    curso = get_object_or_404(Curso, id=curso_id)
    inscripciones = Inscripcion.objects.filter(curso=curso, activo=True)
    
    context = {
        'curso': curso,
        'inscripciones': inscripciones,
        'modo_vista': 'detalle',
        'permisos': {
            'puede_editar': False,  # En detalle no se puede editar
            'puede_gestionar': request.user.has_perm('web.change_curso'),
        }
    }
    return render(request, 'web/profesores/detalle_curso.html', context)

